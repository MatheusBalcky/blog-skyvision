{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 90
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 180
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "tags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string",
      "minLength": 10
    },
    "author": {
      "default": "Equipe Sky Vision",
      "type": "string"
    },
    "type": {
      "default": "article",
      "type": "string",
      "enum": [
        "article",
        "review",
        "guide",
        "comparison"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate",
    "category",
    "tags",
    "cover",
    "coverAlt"
  ]
}