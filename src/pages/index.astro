---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/article/ArticleCard.astro';
import FeaturedCarousel from '../components/home/FeaturedCarousel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredArticles = articles.filter(({ data }) => data.featured).slice(0, 3);
const carouselArticles = featuredArticles.length > 0 ? featuredArticles : articles.slice(0, 1);
const featuredIds = new Set(carouselArticles.map(({ id }) => id));
const latestArticles = articles.filter(({ id }) => !featuredIds.has(id)).slice(0, 6);
---

<BaseLayout>
	<section class="home-hero container-shell">
		<p class="eyebrow">Tecnologia sem complicação</p>
		<h1>Enxergue a tecnologia com uma nova <span>visão.</span></h1>
		<p>
			Reviews honestos, comparativos objetivos e guias de compra para ajudar você a escolher os melhores
			eletrônicos.
		</p>
	</section>

	{
		carouselArticles.length > 0 && (
			<section class="home-section container-shell" aria-labelledby="featured-title">
				<div class="section-heading">
					<div>
						<p class="section-kicker">Seleção Sky Vision</p>
						<h2 id="featured-title">Leitura em destaque</h2>
					</div>
				</div>
				<FeaturedCarousel articles={carouselArticles} />
			</section>
		)
	}

	<section class="home-section container-shell" aria-labelledby="latest-title">
		<div class="section-heading">
			<div>
				<p class="section-kicker">Atualizações</p>
				<h2 id="latest-title">Artigos mais recentes</h2>
			</div>
			<a class="section-link" href="/artigos/">Ver todos <span aria-hidden="true">→</span></a>
		</div>

		<div class="article-grid article-grid-compact">
			{latestArticles.map((article) => <ArticleCard {article} />)}
		</div>
	</section>
</BaseLayout>
