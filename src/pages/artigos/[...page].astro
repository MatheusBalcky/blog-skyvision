---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import Pagination from '../../components/ui/Pagination.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async ({ paginate }) => {
	const articlesPerPage = 9;
	const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	return paginate(articles, { pageSize: articlesPerPage });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<'articles'>>;
}

const { page } = Astro.props;
const pageSuffix = page.currentPage > 1 ? ` — Página ${page.currentPage}` : '';
---

<BaseLayout
	title={`Artigos${pageSuffix} | Sky Vision`}
	description={`Reviews, comparativos e guias de compra sobre celulares, computadores, áudio e outros eletrônicos${page.currentPage > 1 ? ` — página ${page.currentPage}` : ''}.`}
>
	<header class="page-header container-shell">
		<p class="section-kicker">Conteúdo Sky Vision</p>
		<h1>Todos os artigos</h1>
		<p>Informação direta para escolher e aproveitar melhor sua tecnologia.</p>
	</header>

	<section class="home-section container-shell" aria-label="Lista de artigos">
		<div class="article-grid article-grid-compact">
			{page.data.map((article) => <ArticleCard {article} />)}
		</div>
		<Pagination {page} basePath="/artigos/" />
	</section>
</BaseLayout>
