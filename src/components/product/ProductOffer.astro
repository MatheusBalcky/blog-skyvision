---
import { getEntry } from 'astro:content';
import AffiliateProductBox from './AffiliateProductBox.astro';

interface Props {
	productId: string;
	cta?: string;
}

const { productId, cta } = Astro.props;
const product = await getEntry('products', productId);

if (!product) {
	throw new Error(`Produto não encontrado na collection: ${productId}`);
}

const { name, image, imageAlt, affiliateUrl, affiliateStore, active } = product.data;
---

{
	active && (
		<AffiliateProductBox
			{name}
			{image}
			{imageAlt}
			affiliateUrl={affiliateUrl || undefined}
			{affiliateStore}
			{cta}
		/>
	)
}
