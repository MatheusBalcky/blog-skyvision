---
import { categories } from '../../data/categories';

const navigationItems = [
	...categories.map((category) => ({
		label: category.name,
		href: `/categorias/${category.slug}/`,
		icon: category.icon,
	})),
	{ label: 'Guias', href: '/guias/', icon: 'guide' as const },
];
---

<header class="site-header">
	<div class="header-main container-shell">
		<a class="brand" href="/" aria-label="Sky Vision — página inicial">
			<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
				<path d="M7 25.5C12 16.4 19.2 12 28.4 12c5.2 0 9.4 1.5 12.6 4.4-5 9-12.2 13.6-21.4 13.6-5.2 0-9.4-1.5-12.6-4.5Z" />
				<circle cx="24" cy="21" r="4" />
				<path d="M14 7.5c4.8 1.4 9.7 5.6 14.6 12.5 4.8 6.9 6.6 13.1 5.4 18.5-4.9-1.4-9.7-5.6-14.6-12.5C14.6 19.1 12.8 13 14 7.5Z" />
			</svg>
			<span>Sky <strong>Vision</strong></span>
		</a>

		<div class="header-actions">
			<a class="icon-button" href="/busca/" aria-label="Pesquisar">
				<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
			</a>
			<button class="icon-button theme-toggle" type="button" aria-label="Ativar tema escuro" aria-pressed="false">
				<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
				<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15Z" /></svg>
			</button>
		</div>
	</div>

	<nav class="category-nav" aria-label="Navegação principal">
		<div class="category-mobile-bar container-shell">
			<a class="mobile-home-link" href="/" aria-label="Voltar para a página inicial" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8" /><path d="M5.5 9.5V21h13V9.5M9 21v-7h6v7" /></svg>
			</a>
			<button
				class="category-menu-button"
				type="button"
				aria-controls="category-list"
				aria-expanded="false"
			>
				<span>Categorias</span>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
			</button>
		</div>
		<div class="container-shell category-list" id="category-list">
			<a class="desktop-home-link" href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8" /><path d="M5.5 9.5V21h13V9.5M9 21v-7h6v7" /></svg>
				<span>Início</span>
			</a>
			{navigationItems.map((category) => (
				<a href={category.href} aria-current={Astro.url.pathname === category.href ? 'page' : undefined}>
					{category.icon === 'phone' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2" /><path d="M10 5h4M11 19h2" /></svg>}
					{category.icon === 'computer' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 21h8M12 16v5" /></svg>}
					{category.icon === 'audio' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14h4l5 4V6L8 10H4v4Z" /><path d="M16 9a5 5 0 0 1 0 6M18.5 6.5a8.5 8.5 0 0 1 0 11" /></svg>}
					{category.icon === 'mouse' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="6" /><path d="M12 2v6" /></svg>}
					{category.icon === 'home' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8" /><path d="M5.5 9.5V21h13V9.5M9 21v-7h6v7" /></svg>}
					{category.icon === 'guide' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.5A3.5 3.5 0 0 1 7.5 8H20v12H7.5A3.5 3.5 0 0 0 4 23V4.5Z" /><path d="M4 4.5A3.5 3.5 0 0 1 7.5 1H20v7H7.5A3.5 3.5 0 0 0 4 11.5" /></svg>}
					<span>{category.label}</span>
				</a>
			))}
		</div>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const categoryButton = document.querySelector<HTMLButtonElement>('.category-menu-button');
	const categoryList = document.querySelector<HTMLElement>('.category-list');

	const updateToggle = () => {
		const isDark = root.dataset.theme === 'dark';
		toggle?.setAttribute('aria-pressed', String(isDark));
		toggle?.setAttribute('aria-label', isDark ? 'Ativar tema claro' : 'Ativar tema escuro');
	};

	toggle?.addEventListener('click', () => {
		const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = theme;
		localStorage.setItem('sky-vision-theme', theme);
		updateToggle();
	});

	updateToggle();

	const closeCategoryMenu = () => {
		categoryList?.classList.remove('is-open');
		categoryButton?.setAttribute('aria-expanded', 'false');
	};

	categoryButton?.addEventListener('click', () => {
		const isOpen = categoryList?.classList.toggle('is-open') ?? false;
		categoryButton.setAttribute('aria-expanded', String(isOpen));
	});

	categoryList?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', closeCategoryMenu);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && categoryList?.classList.contains('is-open')) {
			closeCategoryMenu();
			categoryButton?.focus();
		}
	});
</script>
